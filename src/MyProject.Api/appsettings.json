{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{Application}] [{Environment}] [{TraceId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/myproject-.json",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 14,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "OpenApi": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "Otlp": {
      "Enabled": false
    }
  },
  "Api": {
    "Cors": {
      "Enabled": false,
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "RequestTimeout": {
      "Enabled": true,
      "Seconds": 30
    }
  },
  "PostgreSql": {
    "Enabled": true
  },
  "MongoDb": {
    "Enabled": true,
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "myproject"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "myproject:",
    "DefaultExpirationMinutes": 30
  },
  "Messaging": {
    "Enabled": false,
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "",
    "RetryCount": 3,
    "RetryIntervalSeconds": 2,
    "ConcurrentMessageLimit": 8
  },
  "Email": {
    "Enabled": false,
    "BaseUrl": "https://api.brevo.com/v3/",
    "ApiKey": "",
    "SenderEmail": "",
    "SenderName": "MyProject"
  },
  "FileStorage": {
    "Enabled": false,
    "Provider": "Local",
    "LocalRoot": "storage",
    "BucketName": "",
    "Region": "ap-southeast-1"
  },
  "Identity": {
    "Enabled": false,
    "Issuer": "MyProject",
    "Audience": "MyProject.Api",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "BackgroundJobs": {
    "Enabled": false,
    "Queue": "default"
  },
  "AllowedHosts": "*"
}
